---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { shuffle } from '../utils/shuffle';

const galleryDir = path.join(process.cwd(), 'public/images/gallery');
const photos = shuffle(
	fs
		.readdirSync(galleryDir)
		.filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
		.map((f) => `/images/gallery/${f}`)
);
---

<BaseLayout title="Beauty & Glamour Photography in CDMX | Devtag' Studios" description="Professional beauty and glamour photography in CDMX (Mexico City) by Devtag' Studios. Polished, editorial portraits with refined lighting and styling.">
	<main>
		<section class="page-intro">
			<h1>Beauty &amp; Glamour Photography</h1>
			<p>Polished, expressive portraits that celebrate natural beauty and confident style. Our beauty and glamour photography combines refined lighting, careful styling, and direct collaboration with each model to create images with a timeless, editorial feel.</p>
		</section>
		<Lightbox photos={photos} subjects={['Beauty and glamour portrait', 'Glamour photography', 'Beauty photoshoot', 'Studio beauty portrait', 'Fashion glamour portrait', 'Model portrait', 'Glamour photo session']} details={['natural light, CDMX', 'soft studio lighting, Mexico City', 'styled by Devtag\' Studios', 'close-up beauty look', 'elegant pose, CDMX', 'editorial style, Mexico City', 'professional model shoot, CDMX', 'by Devtag\' Studios, Mexico City']} />
	</main>
</BaseLayout>
