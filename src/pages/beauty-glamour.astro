---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { shuffle } from '../utils/shuffle';

const galleryDir = path.join(process.cwd(), 'public/images/gallery');
const photos = shuffle(
	fs
		.readdirSync(galleryDir)
		.filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
		.map((f) => `/images/gallery/${f}`)
);
---

<BaseLayout title="Beauty & Glamour | Devtag' Studios" description="Beauty & Glamour photography by Devtag' Studios.">
	<main>
		<Lightbox photos={photos} altPrefix="Beauty & glamour photography" />
	</main>
</BaseLayout>
