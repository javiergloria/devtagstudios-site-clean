---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { shuffle } from '../utils/shuffle';

const boudoirDir = path.join(process.cwd(), 'public/images/boudoir');
const photos = shuffle(
	fs
		.readdirSync(boudoirDir)
		.filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
		.map((f) => `/images/boudoir/${f}`)
);
---

<BaseLayout title="Boudoir Portrait Photography in CDMX | Devtag' Studios" description="Elegant boudoir portrait photography in CDMX (Mexico City) by Devtag' Studios. Tasteful, artistic and professional sessions. Adult audience.">
	<main>
		<section class="page-intro">
			<h1>Boudoir Portrait Photography</h1>
			<p>Elegant, intimate portraits created with respect, trust, and artistic care. Our boudoir photography focuses on mood, light, and confidence, delivering tasteful images in a comfortable, professional setting. This gallery is intended for adult audiences.</p>
		</section>
		<Lightbox photos={photos} subjects={['Boudoir portrait', 'Boudoir photography', 'Elegant boudoir session', 'Intimate portrait', 'Lingerie portrait', 'Artistic boudoir photo', 'Boudoir photoshoot']} details={['moody lighting, CDMX', 'tasteful and artistic, Mexico City', 'lingerie styling, CDMX', 'soft window light, Mexico City', 'by Devtag\' Studios, CDMX', 'professional boudoir session, Mexico City', 'elegant pose, CDMX', 'fine art style, Mexico City']} />
	</main>
</BaseLayout>
