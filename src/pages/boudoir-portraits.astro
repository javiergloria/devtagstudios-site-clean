---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { shuffle } from '../utils/shuffle';

const boudoirDir = path.join(process.cwd(), 'public/images/boudoir');
const photos = shuffle(
	fs
		.readdirSync(boudoirDir)
		.filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
		.map((f) => `/images/boudoir/${f}`)
);
---

<BaseLayout title="Boudoir Portraits | Devtag' Studios" description="Boudoir portrait photography by Devtag' Studios.">
	<main>
		<section class="page-intro">
			<h1>Boudoir Portrait Photography in CDMX</h1>
			<p>Elegant, intimate portraits created with respect, trust, and artistic care. Our boudoir photography focuses on mood, light, and confidence, delivering tasteful images in a comfortable, professional setting in CDMX. This gallery is intended for adult audiences.</p>
		</section>
		<Lightbox photos={photos} altPrefix="Boudoir portrait" />
	</main>
</BaseLayout>
