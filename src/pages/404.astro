---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout noindex title="Page not found | Devtag' Studios" description="This page could not be found. Browse our photography galleries.">
	<main class="notfound">
		<h1>Page not found</h1>
		<p>The page you are looking for does not exist or has moved. Explore our galleries instead:</p>
		<nav class="links">
			<a href="/">Home</a>
			<a href="/beauty-glamour/">Beauty &amp; Glamour</a>
			<a href="/boudoir-portraits/">Boudoir Portraits</a>
			<a href="/urban-street/">Urban &amp; Street</a>
		</nav>

		<h2 lang="es">Página no encontrada</h2>
		<p lang="es">La página que buscas no existe o se ha movido. Explora nuestras galerías:</p>
		<nav class="links" lang="es">
			<a href="/es/">Inicio</a>
			<a href="/es/beauty-glamour/">Belleza y Glamour</a>
			<a href="/es/boudoir-portraits/">Retratos Boudoir</a>
			<a href="/es/urban-street/">Urbano y Calle</a>
		</nav>

		<h2 lang="ja">ページが見つかりません</h2>
		<p lang="ja">お探しのページは存在しないか、移動しました。ギャラリーをご覧ください：</p>
		<nav class="links" lang="ja">
			<a href="/ja/">ホーム</a>
			<a href="/ja/beauty-glamour/">ビューティー＆グラマー</a>
			<a href="/ja/boudoir-portraits/">ブドワール・ポートレート</a>
			<a href="/ja/urban-street/">アーバン＆ストリート</a>
		</nav>
	</main>
</BaseLayout>

<style>
	.notfound {
		text-align: center;
		padding-top: 5rem;
		padding-bottom: 6rem;
	}
	h1 {
		font-size: 2.5rem;
		margin: 0 0 1rem;
	}
	h2 {
		font-size: 1.5rem;
		margin: 2.5rem 0 0.75rem;
		color: var(--brand-color, #1c1c1c);
	}
	p {
		color: var(--brand-color, #555);
		margin: 0 auto 2rem;
		max-width: 520px;
	}
	.links {
		justify-content: center;
	}
</style>
