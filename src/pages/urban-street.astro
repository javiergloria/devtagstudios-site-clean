---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { shuffle } from '../utils/shuffle';

const urbanDir = path.join(process.cwd(), 'public/images/urban');
const photos = shuffle(
	fs
		.readdirSync(urbanDir)
		.filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
		.map((f) => `/images/urban/${f}`)
);
---

<BaseLayout title="Urban & Street | Devtag' Studios" description="Urban and street photography by Devtag' Studios.">
	<main>
		<section class="page-intro">
			<h1>Urban &amp; Street Photography in CDMX</h1>
			<p>Candid and styled work shot in the streets, architecture, and light of CDMX. Our urban and street photography blends fashion, atmosphere, and experimental composition, drawing on more than 19 years of experience across the West and the East.</p>
		</section>
		<Lightbox photos={photos} subjects={['Urban photography', 'Street photography', 'Urban fashion portrait', 'City street portrait', 'Experimental urban photo', 'Street style photoshoot', 'Urban portrait']} details={['city architecture, CDMX', 'stairs and concrete, Mexico City', 'street style, CDMX', 'natural city light, Mexico City', 'by Devtag\' Studios, CDMX', 'urban fashion, Mexico City', 'cinematic city mood, CDMX', 'downtown setting, Mexico City']} />
	</main>
</BaseLayout>
