---
interface Props {
	photos: string[];
	subjects: string[];
	details: string[];
}

import fs from 'node:fs';
import path from 'node:path';

const { photos, subjects, details } = Astro.props;
const thumbFor = (src: string) => {
	const dir = path.posix.dirname(src);
	const name = path.posix.basename(src).replace(/\.[^.]+$/, '');
	const rel = `${dir}/thumbs/${name}.webp`;
	return fs.existsSync(path.join(process.cwd(), 'public', rel)) ? rel : src;
};
const altFor = (i: number) =>
	`${subjects[i % subjects.length]}, ${details[(i * 7 + 3) % details.length]}`;
---

<div class="gallery">
	{photos.map((src, i) => (
		<img
			class="gallery-thumb"
			src={thumbFor(src)}
			alt={altFor(i)}
			loading="lazy"
			decoding="async"
			data-index={i}
			data-full={src}
		/>
	))}
</div>

<div class="lightbox" id="lightbox">
	<div class="lightbox-backdrop"></div>
	<button class="lightbox-close" aria-label="Close">&times;</button>
	<button class="lightbox-prev" aria-label="Previous photo">&#8249;</button>
	<img class="lightbox-img" src="" alt="" />
	<button class="lightbox-next" aria-label="Next photo">&#8250;</button>
	<div class="swipe-hint" aria-hidden="true"><span>&#8249;</span><span class="swipe-hand">&#9757;</span><span>&#8250;</span></div>
</div>

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 0.5rem;
		padding-top: 1rem;
	}
	.gallery-thumb {
		width: 100%;
		height: 300px;
		object-fit: cover;
		display: block;
		cursor: pointer;
		border-radius: 4px;
	}

	.lightbox {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 1000;
		align-items: center;
		justify-content: center;
	}
	.lightbox.open {
		display: flex;
	}
	.lightbox-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}
	.lightbox-img {
		position: relative;
		max-width: 90vw;
		max-height: 88vh;
		object-fit: contain;
		border-radius: 4px;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
		touch-action: pan-y pinch-zoom;
		user-select: none;
		-webkit-user-select: none;
	}
	.lightbox-img.slide-next {
		animation: slideInNext 0.25s ease-out;
	}
	.lightbox-img.slide-prev {
		animation: slideInPrev 0.25s ease-out;
	}
	@keyframes slideInNext {
		from { transform: translateX(40px); opacity: 0.3; }
		to { transform: none; opacity: 1; }
	}
	@keyframes slideInPrev {
		from { transform: translateX(-40px); opacity: 0.3; }
		to { transform: none; opacity: 1; }
	}
	.swipe-hint {
		display: none;
		position: absolute;
		bottom: 2.5rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1001;
		align-items: center;
		gap: 0.75rem;
		padding: 0.6rem 1.1rem;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.6);
		color: #fff;
		font-size: 1.6rem;
		line-height: 1;
		pointer-events: none;
		opacity: 0;
	}
	.swipe-hint.show {
		animation: hintFade 3.2s ease-in-out forwards;
	}
	.swipe-hint.show .swipe-hand {
		animation: hintSwipe 1.1s ease-in-out 3;
	}
	.swipe-hand {
		display: inline-block;
	}
	@keyframes hintSwipe {
		0%, 100% { transform: translateX(-14px); }
		50% { transform: translateX(14px); }
	}
	@keyframes hintFade {
		0% { opacity: 0; }
		10%, 85% { opacity: 1; }
		100% { opacity: 0; }
	}
	/* Touch devices (phones, tablets): swipe instead of arrows */
	@media (hover: none) and (pointer: coarse) {
		.lightbox-prev,
		.lightbox-next {
			display: none;
		}
		.swipe-hint {
			display: flex;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.lightbox-img.slide-next,
		.lightbox-img.slide-prev,
		.swipe-hint.show .swipe-hand {
			animation: none;
		}
	}
	.lightbox-close,
	.lightbox-prev,
	.lightbox-next {
		position: absolute;
		background: rgba(0, 0, 0, 0.4);
		color: #fff;
		border: none;
		cursor: pointer;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
		z-index: 1001;
	}
	.lightbox-close {
		top: 1.25rem;
		right: 1.25rem;
		width: 2.5rem;
		height: 2.5rem;
		font-size: 1.75rem;
	}
	.lightbox-prev,
	.lightbox-next {
		top: 50%;
		transform: translateY(-50%);
		width: 3rem;
		height: 3rem;
		font-size: 2rem;
	}
	.lightbox-prev {
		left: 1rem;
	}
	.lightbox-next {
		right: 1rem;
	}
	.lightbox-close:hover,
	.lightbox-prev:hover,
	.lightbox-next:hover {
		background: rgba(0, 0, 0, 0.7);
	}
</style>

<script>
	function initLightbox() {
		const thumbs = Array.from(document.querySelectorAll<HTMLImageElement>('.gallery-thumb'));
		const lightbox = document.getElementById('lightbox');
		if (!lightbox || thumbs.length === 0) return;

		const img = lightbox.querySelector<HTMLImageElement>('.lightbox-img')!;
		const closeBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-close')!;
		const prevBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-prev')!;
		const nextBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-next')!;
		const backdrop = lightbox.querySelector<HTMLDivElement>('.lightbox-backdrop')!;

		let currentIndex = 0;

		function show(index: number, dir: 'next' | 'prev' | null = null) {
			currentIndex = (index + thumbs.length) % thumbs.length;
			img.classList.remove('slide-next', 'slide-prev');
			if (dir) {
				void img.offsetWidth;
				img.classList.add(dir === 'next' ? 'slide-next' : 'slide-prev');
			}
			const full = thumbs[currentIndex].dataset.full || thumbs[currentIndex].src;
			img.src = full;
			img.alt = thumbs[currentIndex].alt;
		}

		function open(index: number) {
			show(index);
			lightbox!.classList.add('open');
			document.body.style.overflow = 'hidden';
			showHint();
		}

		const hint = lightbox.querySelector<HTMLDivElement>('.swipe-hint')!;
		const isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
		function showHint() {
			if (!isTouch) return;
			try {
				if (localStorage.getItem('swipeHintSeen')) return;
				localStorage.setItem('swipeHintSeen', '1');
			} catch (_) {}
			hint.classList.remove('show');
			void hint.offsetWidth;
			hint.classList.add('show');
		}

		function close() {
			lightbox!.classList.remove('open');
			document.body.style.overflow = '';
		}

		thumbs.forEach((thumb, i) => {
			thumb.addEventListener('click', () => open(i));
		});

		closeBtn.addEventListener('click', close);
		backdrop.addEventListener('click', close);
		prevBtn.addEventListener('click', () => show(currentIndex - 1, 'prev'));
		nextBtn.addEventListener('click', () => show(currentIndex + 1, 'next'));

		document.addEventListener('keydown', (e) => {
			if (!lightbox!.classList.contains('open')) return;
			if (e.key === 'Escape') close();
			if (e.key === 'ArrowLeft') show(currentIndex - 1, 'prev');
			if (e.key === 'ArrowRight') show(currentIndex + 1, 'next');
		});

		// Swipe left/right on touch devices
		if (isTouch) {
			let startX = 0;
			let startY = 0;
			let tracking = false;
			lightbox.addEventListener('touchstart', (e) => {
				if (e.touches.length !== 1) { tracking = false; return; }
				startX = e.touches[0].clientX;
				startY = e.touches[0].clientY;
				tracking = true;
			}, { passive: true });
			lightbox.addEventListener('touchend', (e) => {
				if (!tracking) return;
				tracking = false;
				const t = e.changedTouches[0];
				const dx = t.clientX - startX;
				const dy = t.clientY - startY;
				if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
				hint.classList.remove('show');
				if (dx < 0) show(currentIndex + 1, 'next');
				else show(currentIndex - 1, 'prev');
			}, { passive: true });
		}
	}

	initLightbox();
</script>
