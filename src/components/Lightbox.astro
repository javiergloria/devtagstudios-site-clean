---
interface Props {
	photos: string[];
	subjects: string[];
	details: string[];
	labels?: { close: string; prev: string; next: string };
	sep?: string;
	dates?: Record<string, [string | null, string | null]>;
	sortLabels?: { label: string; shuffle: string; takenNew: string; takenOld: string; addedNew: string; addedOld: string };
}

import fs from 'node:fs';
import path from 'node:path';

const {
	photos,
	subjects,
	details,
	labels = { close: 'Close', prev: 'Previous photo', next: 'Next photo' },
	sep = ', ',
	dates,
	sortLabels,
	mediaLabels,
	mediaToggle = 'auto',
	minVideos = 8,
	columns = 0,
} = Astro.props;
const thumbFor = (src: string) => {
	const dir = path.posix.dirname(src);
	const name = path.posix.basename(src).replace(/\.[^.]+$/, '');
	const rel = `${dir}/thumbs/${name}.webp`;
	return fs.existsSync(path.join(process.cwd(), 'public', rel)) ? rel : src;
};
const isVideo = (src: string) => /\.mp4$/i.test(src);
// Photos/Videos switch (settings: src/data/site-config.json): 'on' = whenever the gallery has a video,
// 'auto' = only once it has `minVideos` videos, 'off' = never.
const videoCount = photos.filter(isVideo).length;
const showMediaToggle = !!mediaLabels && videoCount > 0 && (mediaToggle === 'on' || (mediaToggle === 'auto' && videoCount >= minVideos));
// Fixed column count on desktop (0 = automatic); fewer columns on tablets and phones.
const colStyle = columns > 0 ? `--cols:${columns};--cols-md:${Math.min(columns, 3)};--cols-sm:${Math.min(columns, 2)}` : undefined;
const posterFor = (src: string) => {
	const dir = path.posix.dirname(src);
	const name = path.posix.basename(src).replace(/\.[^.]+$/, '');
	return `${dir}/thumbs/${name}-poster.jpg`;
};
const altFor = (i: number) =>
	`${subjects[i % subjects.length]}${sep}${details[(i * 7 + 3) % details.length]}`;
---

{(sortLabels || showMediaToggle) && (
	<div class="sort-bar">
		{showMediaToggle && mediaLabels && (
			<button type="button" id="media-toggle" class="media-toggle" data-videos={mediaLabels.videos} data-photos={mediaLabels.photos}>{mediaLabels.videos}</button>
		)}
		{sortLabels && (
			<>
				<label for="gallery-sort">{sortLabels.label}</label>
				<select id="gallery-sort">
					<option value="shuffle" selected>{sortLabels.shuffle}</option>
					<option value="taken-new">{sortLabels.takenNew}</option>
					<option value="taken-old">{sortLabels.takenOld}</option>
					<option value="added-new">{sortLabels.addedNew}</option>
					<option value="added-old">{sortLabels.addedOld}</option>
				</select>
			</>
		)}
	</div>
)}

<div class="gallery" data-cols={columns > 0 ? columns : undefined} style={colStyle}>
	{photos.map((src, i) => isVideo(src) ? (
		<span class="thumb-wrap">
			<img
				class="gallery-thumb"
				src={thumbFor(src)}
				alt={altFor(i)}
				loading="lazy"
				decoding="async"
				data-index={i}
				data-full={src}
				data-taken={dates?.[src]?.[0] ?? ''}
				data-added={dates?.[src]?.[1] ?? ''}
				data-video="1"
				data-poster={posterFor(src)}
			/>
			<span class="play-badge" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
		</span>
	) : (
		<img
			class="gallery-thumb"
			src={thumbFor(src)}
			alt={altFor(i)}
			loading="lazy"
			decoding="async"
			data-index={i}
			data-full={src}
			data-taken={dates?.[src]?.[0] ?? ''}
			data-added={dates?.[src]?.[1] ?? ''}
		/>
	))}
</div>

<div class="lightbox" id="lightbox">
	<div class="lightbox-backdrop"></div>
	<button class="lightbox-close" aria-label={labels.close}>&times;</button>
	<button class="lightbox-prev" aria-label={labels.prev}>&#8249;</button>
	<img class="lightbox-img" src="" alt="" />
	<video class="lightbox-video" controls playsinline preload="metadata" hidden></video>
	<button class="lightbox-next" aria-label={labels.next}>&#8250;</button>
	<div class="swipe-hint" aria-hidden="true"><span>&#8249;</span><span class="swipe-hand">&#9757;</span><span>&#8250;</span></div>
</div>

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 0.5rem;
		padding-top: 1rem;
	}
	.gallery[data-cols] {
		grid-template-columns: repeat(var(--cols), 1fr);
	}
	@media (max-width: 900px) {
		.gallery[data-cols] { grid-template-columns: repeat(var(--cols-md), 1fr); }
	}
	@media (max-width: 560px) {
		.gallery[data-cols] { grid-template-columns: repeat(var(--cols-sm), 1fr); }
	}
	.gallery-thumb {
		width: 100%;
		height: 300px;
		object-fit: cover;
		display: block;
		cursor: pointer;
		border-radius: 4px;
	}

	.sort-bar {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
		padding-top: 1rem;
		font-size: 0.9rem;
		color: var(--brand-color, #555);
	}
	.media-toggle {
		margin-right: auto;
		font: inherit;
		font-weight: 600;
		color: inherit;
		background: transparent;
		border: none;
		padding: 0.25rem 0;
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}
	.media-toggle:hover {
		opacity: 0.75;
	}
	.sort-bar select {
		font: inherit;
		color: inherit;
		background: transparent;
		border: 1px solid currentColor;
		border-radius: 4px;
		padding: 0.25rem 0.5rem;
		cursor: pointer;
	}
	.sort-bar + .gallery {
		padding-top: 0.5rem;
	}
	.thumb-wrap {
		position: relative;
		display: block;
	}
	.thumb-wrap[hidden],
	.gallery-thumb[hidden] {
		display: none;
	}
	.play-badge {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 3.75rem;
		height: 3.75rem;
		transform: translate(-50%, -50%);
		display: flex;
		align-items: center;
		justify-content: center;
		padding-left: 0.2rem;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.55);
		border: 2px solid rgba(255, 255, 255, 0.9);
		color: #fff;
		pointer-events: none;
		transition: transform 0.15s ease, background 0.15s ease;
	}
	.thumb-wrap:hover .play-badge {
		transform: translate(-50%, -50%) scale(1.08);
		background: rgba(0, 0, 0, 0.75);
	}

	.lightbox {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 1000;
		align-items: center;
		justify-content: center;
	}
	.lightbox.open {
		display: flex;
	}
	.lightbox-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}
	.lightbox-img {
		position: relative;
		max-width: 90vw;
		max-height: 88vh;
		object-fit: contain;
		border-radius: 4px;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
		touch-action: pan-y pinch-zoom;
		user-select: none;
		-webkit-user-select: none;
		cursor: zoom-in;
		transition: transform 0.2s ease-out;
	}
	.lightbox-img.zoomed {
		transform: scale(2.4);
		cursor: zoom-out;
		touch-action: none;
		transition: none;
		animation: none;
	}
	.lightbox-video {
		position: relative;
		max-width: 90vw;
		max-height: 88vh;
		border-radius: 4px;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
		background: #000;
	}
	.lightbox-video[hidden],
	.lightbox-img[hidden] {
		display: none;
	}
	.lightbox-img.slide-next,
	.lightbox-video.slide-next {
		animation: slideInNext 0.25s ease-out;
	}
	.lightbox-img.slide-prev,
	.lightbox-video.slide-prev {
		animation: slideInPrev 0.25s ease-out;
	}
	@keyframes slideInNext {
		from { transform: translateX(40px); opacity: 0.3; }
		to { transform: none; opacity: 1; }
	}
	@keyframes slideInPrev {
		from { transform: translateX(-40px); opacity: 0.3; }
		to { transform: none; opacity: 1; }
	}
	.swipe-hint {
		display: none;
		position: absolute;
		bottom: 2.5rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1001;
		align-items: center;
		gap: 0.75rem;
		padding: 0.6rem 1.1rem;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.6);
		color: #fff;
		font-size: 1.6rem;
		line-height: 1;
		pointer-events: none;
		opacity: 0;
	}
	.swipe-hint.show {
		animation: hintFade 3.2s ease-in-out forwards;
	}
	.swipe-hint.show .swipe-hand {
		animation: hintSwipe 1.1s ease-in-out 3;
	}
	.swipe-hand {
		display: inline-block;
	}
	@keyframes hintSwipe {
		0%, 100% { transform: translateX(-14px); }
		50% { transform: translateX(14px); }
	}
	@keyframes hintFade {
		0% { opacity: 0; }
		10%, 85% { opacity: 1; }
		100% { opacity: 0; }
	}
	/* Touch devices (phones, tablets): swipe instead of arrows */
	@media (hover: none) and (pointer: coarse) {
		.lightbox-prev,
		.lightbox-next {
			display: none;
		}
		.swipe-hint {
			display: flex;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.lightbox-img.slide-next,
		.lightbox-img.slide-prev,
		.swipe-hint.show .swipe-hand {
			animation: none;
		}
	}
	.lightbox-close,
	.lightbox-prev,
	.lightbox-next {
		position: absolute;
		background: rgba(0, 0, 0, 0.4);
		color: #fff;
		border: none;
		cursor: pointer;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
		z-index: 1001;
	}
	.lightbox-close {
		top: 1.25rem;
		right: 1.25rem;
		width: 2.5rem;
		height: 2.5rem;
		font-size: 1.75rem;
	}
	.lightbox-prev,
	.lightbox-next {
		top: 50%;
		transform: translateY(-50%);
		width: 3rem;
		height: 3rem;
		font-size: 2rem;
	}
	.lightbox-prev {
		left: 1rem;
	}
	.lightbox-next {
		right: 1rem;
	}
	.lightbox-close:hover,
	.lightbox-prev:hover,
	.lightbox-next:hover {
		background: rgba(0, 0, 0, 0.7);
	}
</style>

<script>
	function initLightbox() {
		const allThumbs = Array.from(document.querySelectorAll<HTMLImageElement>('.gallery-thumb'));
			let thumbs = allThumbs.slice(); // thumbs currently visible (used by the lightbox)
		const lightbox = document.getElementById('lightbox');
		if (!lightbox || thumbs.length === 0) return;

		const img = lightbox.querySelector<HTMLImageElement>('.lightbox-img')!;
		const video = lightbox.querySelector<HTMLVideoElement>('.lightbox-video')!;
		const closeBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-close')!;
		const prevBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-prev')!;
		const nextBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-next')!;
		const backdrop = lightbox.querySelector<HTMLDivElement>('.lightbox-backdrop')!;

		let currentIndex = 0;

		function show(index: number, dir: 'next' | 'prev' | null = null) {
			currentIndex = (index + thumbs.length) % thumbs.length;
			const t = thumbs[currentIndex];
			const el = t.dataset.video ? video : img;
			stopVideo();
			resetZoom();
			el.classList.remove('slide-next', 'slide-prev');
			if (dir) {
				void el.offsetWidth;
				el.classList.add(dir === 'next' ? 'slide-next' : 'slide-prev');
			}
			const full = t.dataset.full || t.src;
			if (t.dataset.video) {
				img.hidden = true;
				video.hidden = false;
				video.poster = t.dataset.poster || '';
				video.src = full;
				video.setAttribute('aria-label', t.alt);
			} else {
				video.hidden = true;
				img.hidden = false;
				img.src = full;
				img.alt = t.alt;
			}
		}

		// Zoom: click/tap the photo to zoom in, move the pointer (or drag a finger) to pan, click again to zoom out.
		function setOrigin(x: number, y: number) {
			// Use the unzoomed box (saved on zoom-in): the live rect is scaled while zoomed.
			const px = Math.min(1, Math.max(0, (x - zoomBox.left) / zoomBox.width));
			const py = Math.min(1, Math.max(0, (y - zoomBox.top) / zoomBox.height));
			img.style.transformOrigin = `${px * 100}% ${py * 100}%`;
		}
		let zoomed = false;
		let zoomBox = { left: 0, top: 0, width: 1, height: 1 };
		function resetZoom() {
			zoomed = false;
			img.classList.remove('zoomed');
			img.style.transformOrigin = '';
		}
		img.addEventListener('click', (e) => {
			if (zoomed) { resetZoom(); return; }
			const r = img.getBoundingClientRect();
			zoomBox = { left: r.left, top: r.top, width: r.width, height: r.height };
			setOrigin(e.clientX, e.clientY);
			zoomed = true;
			img.classList.add('zoomed');
		});
		img.addEventListener('mousemove', (e) => { if (zoomed) setOrigin(e.clientX, e.clientY); });
		img.addEventListener('touchmove', (e) => {
			if (zoomed && e.touches.length === 1) {
				e.preventDefault();
				setOrigin(e.touches[0].clientX, e.touches[0].clientY);
			}
		}, { passive: false });

		function stopVideo() {
			video.pause();
			if (video.getAttribute('src')) {
				video.removeAttribute('src');
				video.load();
			}
		}

		function open(index: number) {
			show(index);
			lightbox!.classList.add('open');
			document.body.style.overflow = 'hidden';
			showHint();
		}

		const hint = lightbox.querySelector<HTMLDivElement>('.swipe-hint')!;
		const isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
		function showHint() {
			if (!isTouch) return;
			try {
				if (localStorage.getItem('swipeHintSeen')) return;
				localStorage.setItem('swipeHintSeen', '1');
			} catch (_) {}
			hint.classList.remove('show');
			void hint.offsetWidth;
			hint.classList.add('show');
		}

		function close() {
			stopVideo();
			resetZoom();
			lightbox!.classList.remove('open');
			document.body.style.overflow = '';
		}

		allThumbs.forEach((thumb) => {
			thumb.addEventListener('click', () => open(thumbs.indexOf(thumb)));
		});

		// Sort control (only on galleries that pass dates). Photos without a date go last.
		const sortSel = document.getElementById('gallery-sort') as HTMLSelectElement | null;
		const grid = document.querySelector<HTMLElement>('.gallery');
		if (sortSel && grid) {
			const unit = (t: HTMLImageElement) => (t.parentElement!.classList.contains('thumb-wrap') ? t.parentElement! : t);
			sortSel.addEventListener('change', () => {
				const mode = sortSel.value;
				const items = allThumbs.slice();
				if (mode === 'shuffle') {
					for (let i = items.length - 1; i > 0; i--) {
						const j = Math.floor(Math.random() * (i + 1));
						[items[i], items[j]] = [items[j], items[i]];
					}
				} else {
					const field = mode.startsWith('taken') ? 'taken' : 'added';
					const dir = mode.endsWith('new') ? -1 : 1;
					items.sort((a, b) => {
						const x = a.dataset[field] || '';
						const y = b.dataset[field] || '';
						if (!x && !y) return 0;
						if (!x) return 1;
						if (!y) return -1;
						return x < y ? -dir : x > y ? dir : 0;
					});
				}
				items.forEach((t) => grid.appendChild(unit(t)));
				allThumbs.splice(0, allThumbs.length, ...items);
				applyView();
			});
		}

		// Photos/Videos switch (only rendered when the gallery has enough videos). Without it, everything shows together.
		const mediaBtn = document.getElementById('media-toggle') as HTMLButtonElement | null;
		let view: 'photos' | 'videos' | 'all' = mediaBtn ? 'photos' : 'all';
		function applyView() {
			allThumbs.forEach((t) => {
				const wrap = t.parentElement!.classList.contains('thumb-wrap') ? t.parentElement! : t;
				const isVid = !!t.dataset.video;
				(wrap as HTMLElement).hidden = view === 'photos' ? isVid : view === 'videos' ? !isVid : false;
			});
			thumbs = allThumbs.filter((t) => !(t.parentElement!.classList.contains('thumb-wrap') ? t.parentElement! : t).hidden);
		}
		if (mediaBtn) {
			mediaBtn.textContent = mediaBtn.dataset.videos || '';
			mediaBtn.addEventListener('click', () => {
				view = view === 'photos' ? 'videos' : 'photos';
				mediaBtn.textContent = (view === 'photos' ? mediaBtn.dataset.videos : mediaBtn.dataset.photos) || '';
				applyView();
			});
		}
		applyView();

		closeBtn.addEventListener('click', close);
		backdrop.addEventListener('click', close);
		prevBtn.addEventListener('click', () => show(currentIndex - 1, 'prev'));
		nextBtn.addEventListener('click', () => show(currentIndex + 1, 'next'));

		document.addEventListener('keydown', (e) => {
			if (!lightbox!.classList.contains('open')) return;
			if (e.key === 'Escape') close();
			if (e.key === 'ArrowLeft') show(currentIndex - 1, 'prev');
			if (e.key === 'ArrowRight') show(currentIndex + 1, 'next');
		});

		// Swipe left/right on touch devices
		if (isTouch) {
			let startX = 0;
			let startY = 0;
			let tracking = false;
			lightbox.addEventListener('touchstart', (e) => {
				if (e.touches.length !== 1 || e.target === video || zoomed) { tracking = false; return; }
				startX = e.touches[0].clientX;
				startY = e.touches[0].clientY;
				tracking = true;
			}, { passive: true });
			lightbox.addEventListener('touchend', (e) => {
				if (!tracking) return;
				tracking = false;
				const t = e.changedTouches[0];
				const dx = t.clientX - startX;
				const dy = t.clientY - startY;
				if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
				hint.classList.remove('show');
				if (dx < 0) show(currentIndex + 1, 'next');
				else show(currentIndex - 1, 'prev');
			}, { passive: true });
		}
	}

	initLightbox();
</script>
