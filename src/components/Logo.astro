---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	class={`site-logo ${className ?? ''}`}
	viewBox="0 0 500 500"
	xmlns="http://www.w3.org/2000/svg"
	role="img"
	aria-label="Devtag' Studios"
>
	<path
		fill="currentColor"
		fill-rule="evenodd"
		d="M 312.0,381.5 L 246.0,327.5 L 186.0,381.5 L 161.5,356.0 L 186.0,332.5 L 203.0,346.5 L 234.5,318.0 L 160.5,256.0 L 228.5,194.0 L 181.0,149.5 L 171.0,158.5 L 160.5,147.0 L 189.0,117.5 L 254.0,171.5 L 315.0,118.5 L 338.5,144.0 L 312.0,167.5 L 297.0,152.5 L 266.5,181.0 L 339.5,243.0 L 271.5,305.0 L 317.0,347.5 L 321.0,349.5 L 330.0,341.5 L 339.5,352.0 Z M 259.5,294.0 L 298.5,256.0 L 241.0,204.5 L 200.5,243.0 Z"
	></path>
</svg>

<script>
	const LOGO_COLORS = ['#111111', '#6b7280', '#012b55', '#b91c1c'];
	const color = LOGO_COLORS[Math.floor(Math.random() * LOGO_COLORS.length)];
	document.querySelectorAll<HTMLElement>('.site-logo').forEach((el) => {
		el.style.color = color;
	});
</script>
