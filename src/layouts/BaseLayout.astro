---
interface Props {
	title: string;
	description?: string;
}

import Logo from '../components/Logo.astro';

const { title, description = "Devtag' Studios | Photography and Videography in CDMX" } = Astro.props;

const siteUrl = 'https://devtagstudios.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = `${siteUrl}/og-image.jpg`;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': ['ProfessionalService', 'LocalBusiness'],
			'@id': `${siteUrl}/#business`,
			name: "Devtag' Studios",
			url: `${siteUrl}/`,
			logo: `${siteUrl}/favicon.png`,
			image: `${siteUrl}/favicon.png`,
			description:
				"Professional glamour, beauty, boudoir, street, urban, and experimental photography and videography with over 19 years of experience.",
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Mexico City',
				addressRegion: 'CDMX',
				addressCountry: 'MX',
			},
			areaServed: [
				{ '@type': 'City', name: 'Mexico City' },
				{ '@type': 'Country', name: 'Mexico' },
			],
			knowsAbout: [
				'Glamour photography',
				'Beauty photography',
				'Boudoir photography',
				'Street photography',
				'Urban photography',
				'Experimental photography',
				'Videography',
			],
			sameAs: ['https://x.com/devtagstudios1'],
		},
		{
			'@type': 'WebSite',
			'@id': `${siteUrl}/#website`,
			url: `${siteUrl}/`,
			name: "Devtag' Studios",
			publisher: { '@id': `${siteUrl}/#business` },
			inLanguage: 'en',
		},
	],
};

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/beauty-glamour', label: 'Beauty & Glamour' },
	{ href: '/boudoir-portraits', label: 'Boudoir Portraits' },
	{ href: '/urban-street', label: 'Urban & Street' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&display=swap" rel="stylesheet" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Devtag' Studios" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<script is:inline>
			(function () {
				var BRAND_COLORS = ['#111111', '#6b7280', '#012b55', '#b91c1c', '#0f766e', '#5b21b6', '#be185d', '#0e7490', '#3730a3', '#86198f'];
				var color = BRAND_COLORS[Math.floor(Math.random() * BRAND_COLORS.length)];
				document.documentElement.style.setProperty('--brand-color', color);
			})();
		</script>
	</head>
	<body>
		<header>
			<div class="header-inner">
				<a class="logo" href="/">
					<Logo />
				</a>
				<nav>
					{navLinks.map((link) => (
						<a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a>
					))}
				</nav>
			</div>
		</header>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
		color: #1c1c1c;
		background: #fff;
		line-height: 1.6;
	}
	body {
		margin: 0;
	}
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: #fff;
	}
	.header-inner {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding: 1.5rem;
	}
	.site-logo {
		color: var(--brand-color, #111111);
	}
	.logo .site-logo {
		height: 40px;
		width: auto;
		display: block;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
	}
	nav a {
		color: var(--brand-color, #1c1c1c);
		text-decoration: none;
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	nav a:hover {
		opacity: 0.6;
	}
	main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem 4rem;
	}
	.page-intro {
		padding: 1rem 0 0.5rem;
		text-align: center;
	}
	.page-intro h1 {
		font-size: 2rem;
		margin: 0 0 0.75rem;
	}
	.page-intro p {
		max-width: 720px;
		margin: 0 auto;
		text-align: justify;
		text-align-last: center;
		color: var(--brand-color, #444);
	}
	h1 {
		font-family: 'Baloo 2', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
		color: var(--brand-color, #1c1c1c);
	}
</style>
