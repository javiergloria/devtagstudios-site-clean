---
import type { Lang, PageKey } from '../i18n/ui';

interface Props {
	title: string;
	description?: string;
	adult?: boolean;
	noindex?: boolean;
	lang?: Lang;
	/** Which page this is; used for the language switcher and hreflang alternates. Omit for pages with no translations (404). */
	pageKey?: PageKey;
}

import Logo from '../components/Logo.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import { dict, meta, languages, pagePath } from '../i18n/ui';

const { adult = false, noindex = false, title, lang = 'en', pageKey } = Astro.props;
const t = dict[lang];
const description = Astro.props.description ?? t.defaultDescription;

const siteUrl = 'https://devtagstudios.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const alternates = pageKey
	? languages.map((l) => ({ lang: l, href: new URL(pagePath(l, pageKey), siteUrl).href, path: pagePath(l, pageKey) }))
	: [];
const altPaths = Object.fromEntries(alternates.map((a) => [a.lang, a.path]));
const ogImage = `${siteUrl}/og-image.jpg`;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': ['ProfessionalService', 'LocalBusiness'],
			'@id': `${siteUrl}/#business`,
			name: "Devtag' Studios",
			url: `${siteUrl}/`,
			logo: `${siteUrl}/favicon.png`,
			image: `${siteUrl}/favicon.png`,
			description: t.jsonLdDescription,
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Mexico City',
				addressRegion: 'CDMX',
				addressCountry: 'MX',
			},
			areaServed: [
				{ '@type': 'City', name: 'Mexico City' },
				{ '@type': 'Country', name: 'Mexico' },
			],
			knowsAbout: [
				'Glamour photography',
				'Beauty photography',
				'Boudoir photography',
				'Street photography',
				'Urban photography',
				'Experimental photography',
				'Videography',
			],
			sameAs: ['https://x.com/devtagstudios1'],
		},
		{
			'@type': 'WebSite',
			'@id': `${siteUrl}/#website`,
			url: `${siteUrl}/`,
			name: "Devtag' Studios",
			publisher: { '@id': `${siteUrl}/#business` },
			inLanguage: languages.map((l) => meta[l].htmlLang),
		},
	],
};

const navKeys: PageKey[] = ['home', 'beauty-glamour', 'boudoir-portraits', 'urban-street'];
const navLinks = navKeys.map((key) => ({ href: pagePath(lang, key), label: t.nav[key] }));
---

<html lang={meta[lang].htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&display=swap" rel="stylesheet" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{alternates.map((a) => <link rel="alternate" hreflang={meta[a.lang].htmlLang} href={a.href} />)}
		{alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === 'en')?.href} />}
		{noindex && <meta name="robots" content="noindex" />}
		{adult && <meta name="rating" content="adult" />}
		{adult && <meta name="rating" content="RTA-5042-1996-1400-1577-RTA" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Devtag' Studios" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={meta[lang].ogLocale} />
		{languages.filter((l) => l !== lang && alternates.length > 0).map((l) => <meta property="og:locale:alternate" content={meta[l].ogLocale} />)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		{/* First visit: if the visitor's browser language is Spanish or Japanese, send them to that version.
		    Only runs on the English (default) URLs, only when no language was chosen with the flags, and never for search bots
		    (they send no Spanish/Japanese preference). */}
		{pageKey && (
			<script is:inline set:html={`window.__ALT=${JSON.stringify(altPaths)};(function(){try{var cur=document.documentElement.getAttribute('lang');if(cur!=='en'||!window.__ALT)return;var saved=null;try{saved=localStorage.getItem('lang');}catch(e){}var target=null;if(saved){target=saved;}else{var langs=(navigator.languages&&navigator.languages.length)?navigator.languages:[navigator.language||''];for(var i=0;i<langs.length;i++){var p=String(langs[i]).toLowerCase().split('-')[0];if(p==='es'||p==='ja'||p==='en'){target=p;break;}}}if(target&&target!=='en'&&window.__ALT[target]){location.replace(window.__ALT[target]+location.search+location.hash);}}catch(e){}})();`} />
		)}

		<script is:inline>
			(function () {
				var BRAND_COLORS = ['#111111', '#6b7280', '#012b55', '#b91c1c', '#0f766e', '#5b21b6', '#be185d', '#0e7490', '#3730a3', '#86198f'];
				var color = BRAND_COLORS[Math.floor(Math.random() * BRAND_COLORS.length)];
				document.documentElement.style.setProperty('--brand-color', color);
			})();
		</script>
	</head>
	<body>
		<header>
			<div class="header-inner">
				<a class="logo" href={pagePath(lang, 'home')}>
					<Logo />
				</a>
				<nav>
					{navLinks.map((link) => (
						<a href={link.href}>{link.label}</a>
					))}
				</nav>
				{pageKey && <LangSwitcher lang={lang} pageKey={pageKey} />}
			</div>
		</header>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
		color: #1c1c1c;
		background: #fff;
		line-height: 1.6;
	}
	body {
		margin: 0;
	}
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: #fff;
	}
	.header-inner {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding: 1.5rem;
	}
	.site-logo {
		color: var(--brand-color, #111111);
	}
	.logo .site-logo {
		height: 40px;
		width: auto;
		display: block;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
	}
	nav a {
		color: var(--brand-color, #1c1c1c);
		text-decoration: none;
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	nav a:hover {
		opacity: 0.6;
	}
	main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem 4rem;
	}
	.page-intro {
		padding: 1rem 0 0.5rem;
		text-align: center;
	}
	.page-intro h1 {
		font-size: 2rem;
		margin: 0 0 0.75rem;
	}
	.page-intro p {
		max-width: 720px;
		margin: 0 auto;
		text-align: justify;
		text-align-last: center;
		color: var(--brand-color, #444);
	}
	h1 {
		font-family: 'Baloo 2', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
		color: var(--brand-color, #1c1c1c);
	}
</style>
